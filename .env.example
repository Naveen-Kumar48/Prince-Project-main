# ==============================================================================
# VERCEL ENVIRONMENT VARIABLES CONFIGURATION - AJAY READYMADE STORE
# ==============================================================================

# 1. DATABASE CONNECTION (SUPABASE / POSTGRESQL)
# Add your live Supabase / PostgreSQL database URL in Vercel Environment Variables
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# 2. CLIENT CONFIGURABLE PARAMETERS
# WhatsApp Enquiry redirect number (with country code, e.g. 919812000000)
NEXT_PUBLIC_WHATSAPP_NUMBER="919596885527"

# Canonical URL of your Vercel deployment / custom domain
NEXT_PUBLIC_SITE_URL="https://ajayreadymade.com"

# Google Search Console Verification Token (meta tag content)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="EvOfUDkXuXYL9HMlVBcCAFUxTiPrsLCYBJXEU9E91Zs"

# 3. SECURITY & AUTHENTICATION
# Set a secure password for the Admin Panel (/admin) access
ADMIN_PASSWORD="your-secure-admin-password"
